+    load_marker = "_qwen38_round_profile_load_model"
+    if not GPUModelRunner.__dict__.get(load_marker, False):
+        original_load = GPUModelRunner.load_model
+        @functools.wraps(original_load)
+        def load_model_profiled(self, *args, **kwargs):
