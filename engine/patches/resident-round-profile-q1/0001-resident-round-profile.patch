+def _round_profile_callable(
+    label,
+    function,
+    phase_name=None,
+    host_name=None,
+    profiler_arg_index=0,
+):
+    @functools.wraps(function)
+    def profiled(*args, **kwargs):
+        owner = args[profiler_arg_index] if len(args) > profiler_arg_index else None
+        profiler = getattr(owner, "_resident_phase_profiler", None)
+        phase_token = (
+            profiler.begin(phase_name)
+            if profiler is not None and phase_name is not None
+            else None
+        )
+        host_started = (
+            profiler.host_begin(host_name)
+            if profiler is not None and host_name is not None
+            else None
+        )
+        try:
+            if _ROUND_RECORD_FUNCTIONS:
+                with torch.profiler.record_function(label):
+                    return function(*args, **kwargs)
+            return function(*args, **kwargs)
+        finally:
+            if profiler is not None:
+                if host_name is not None:
+                    profiler.host_end(host_name, host_started)
+                if phase_name is not None:
+                    profiler.end(phase_token)
+    return profiled
+
+
+def _round_profile_class_method(
+    cls,
+    method_name,
+    label,
+    marker,
+    phase_name=None,
+    host_name=None,
+    profiler_arg_index=0,
+):
+    if cls.__dict__.get(marker, False):
+        return
+    setattr(
+        cls,
+        method_name,
+        _round_profile_callable(
+            label,
+            getattr(cls, method_name),
+            phase_name=phase_name,
+            host_name=host_name,
+            profiler_arg_index=profiler_arg_index,
+        ),
+    )
+    setattr(cls, marker, True)
+
+
+def _round_profile_eager_target_forward(runner, model, model_inputs):
+    profiler = getattr(runner, "_resident_phase_profiler", None)
+    if profiler is None or not profiler.enabled or not profiler._primed:
+        return model(**model_inputs)
+    phase_token = profiler.begin("target_model_forward")
+    host_started = profiler.host_begin("target_model_forward_host")
+    try:
+        if _ROUND_RECORD_FUNCTIONS:
+            with torch.profiler.record_function("vllm.round_profile.target_model_call"):
+                return model(**model_inputs)
+        return model(**model_inputs)
+    finally:
+        profiler.host_end("target_model_forward_host", host_started)
+        profiler.end(phase_token)
+
